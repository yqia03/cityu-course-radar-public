{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cityu-course-radar",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "APP_ORIGIN": "https://your-domain.example",
    "CONTACT_EMAIL": "",
    "MATERIALS_UPLOAD_MODE": "admin-only"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cityu-course-radar-prod",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MATERIALS",
      "bucket_name": "cityu-course-materials"
    }
  ]
}
